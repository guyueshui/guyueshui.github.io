{{- $index := slice -}}
{{- range .Site.RegularPages -}}
  {{- if and (ne .Params.searchExclude true) (ne .Layout "search") (ne .Type "search") -}}
    {{- $content := .Plain | htmlUnescape | replaceRE "\\s+" " " -}}
    {{- $summary := .Summary | plainify | htmlUnescape | replaceRE "\\s+" " " -}}
    {{- $index = $index | append (dict
        "title" .Title
        "url" .RelPermalink
        "permalink" .Permalink
        "date" (.Date.Format "2006-01-02")
        "timestamp" (.Date.Unix)
        "tags" .Params.tags
        "categories" .Params.categories
        "summary" $summary
        "content" $content
      )
    -}}
  {{- end -}}
{{- end -}}
{{- $index | jsonify -}}
